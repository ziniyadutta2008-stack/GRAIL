{
  "$defs": {
    "AgentStatus": {
      "enum": [
        "Completed",
        "Needs Information",
        "Rejected Input",
        "Failed"
      ],
      "title": "AgentStatus",
      "type": "string"
    },
    "ExecutionMetrics": {
      "additionalProperties": false,
      "properties": {
        "estimated_cost_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Estimated Cost Usd",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "title": "ExecutionMetrics",
      "type": "object"
    },
    "GenerationMode": {
      "enum": [
        "bedrock",
        "deterministic_seed"
      ],
      "title": "GenerationMode",
      "type": "string"
    },
    "IntakeProposal": {
      "additionalProperties": false,
      "properties": {
        "affected_people": {
          "items": {
            "type": "string"
          },
          "title": "Affected People",
          "type": "array"
        },
        "data_categories": {
          "items": {
            "type": "string"
          },
          "title": "Data Categories",
          "type": "array"
        },
        "deployment_pattern": {
          "title": "Deployment Pattern",
          "type": "string"
        },
        "human_oversight": {
          "title": "Human Oversight",
          "type": "string"
        },
        "intended_uses": {
          "items": {
            "type": "string"
          },
          "title": "Intended Uses",
          "type": "array"
        },
        "materiality_rationale": {
          "title": "Materiality Rationale",
          "type": "string"
        },
        "preliminary_materiality": {
          "$ref": "#/$defs/Severity"
        },
        "prohibited_uses": {
          "items": {
            "type": "string"
          },
          "title": "Prohibited Uses",
          "type": "array"
        },
        "questions": {
          "description": "Missing-information questions for the owner.",
          "items": {
            "type": "string"
          },
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "intended_uses",
        "prohibited_uses",
        "affected_people",
        "data_categories",
        "deployment_pattern",
        "human_oversight",
        "preliminary_materiality",
        "materiality_rationale",
        "questions"
      ],
      "title": "IntakeProposal",
      "type": "object"
    },
    "ModelMetadata": {
      "additionalProperties": false,
      "properties": {
        "generation_mode": {
          "$ref": "#/$defs/GenerationMode"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "prompt_template_id": {
          "title": "Prompt Template Id",
          "type": "string"
        },
        "prompt_template_version": {
          "title": "Prompt Template Version",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        }
      },
      "required": [
        "generation_mode",
        "prompt_template_id",
        "prompt_template_version"
      ],
      "title": "ModelMetadata",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page or section reference.",
          "title": "Location"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "record_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Version"
        }
      },
      "required": [
        "record_id"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "const": "governance_intake",
      "title": "Agent Id",
      "type": "string"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "confidence": {
      "description": "Explanatory only; never used as an approval threshold.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "execution_id": {
      "format": "uuid",
      "title": "Execution Id",
      "type": "string"
    },
    "metrics": {
      "$ref": "#/$defs/ExecutionMetrics"
    },
    "missing_information": {
      "items": {
        "type": "string"
      },
      "title": "Missing Information",
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/ModelMetadata"
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/IntakeProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Sources",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/AgentStatus"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "execution_id",
    "agent_id",
    "status",
    "sources",
    "assumptions",
    "missing_information",
    "confidence",
    "warnings",
    "model",
    "metrics",
    "content_hash"
  ],
  "title": "GovernanceIntakeOutput",
  "type": "object"
}
