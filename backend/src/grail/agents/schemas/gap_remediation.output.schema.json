{
  "$defs": {
    "AgentStatus": {
      "enum": [
        "Completed",
        "Needs Information",
        "Rejected Input",
        "Failed"
      ],
      "title": "AgentStatus",
      "type": "string"
    },
    "DraftFinding": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "reference": {
          "title": "Reference",
          "type": "string"
        },
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "title",
        "requirement_id",
        "severity",
        "rationale",
        "evidence_ids"
      ],
      "title": "DraftFinding",
      "type": "object"
    },
    "DraftRemediationAction": {
      "additionalProperties": false,
      "properties": {
        "definition_of_done": {
          "minLength": 20,
          "title": "Definition Of Done",
          "type": "string"
        },
        "finding_reference": {
          "title": "Finding Reference",
          "type": "string"
        },
        "suggested_due_in_days": {
          "exclusiveMinimum": 0,
          "maximum": 365,
          "title": "Suggested Due In Days",
          "type": "integer"
        },
        "suggested_owner_role": {
          "$ref": "#/$defs/Role"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "finding_reference",
        "title",
        "definition_of_done",
        "suggested_owner_role",
        "suggested_due_in_days"
      ],
      "title": "DraftRemediationAction",
      "type": "object"
    },
    "ExecutionMetrics": {
      "additionalProperties": false,
      "properties": {
        "estimated_cost_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Estimated Cost Usd",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "title": "ExecutionMetrics",
      "type": "object"
    },
    "GapRemediationProposal": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/DraftRemediationAction"
          },
          "title": "Actions",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/DraftFinding"
          },
          "title": "Findings",
          "type": "array"
        }
      },
      "required": [
        "findings",
        "actions"
      ],
      "title": "GapRemediationProposal",
      "type": "object"
    },
    "GenerationMode": {
      "enum": [
        "bedrock",
        "deterministic_seed"
      ],
      "title": "GenerationMode",
      "type": "string"
    },
    "ModelMetadata": {
      "additionalProperties": false,
      "properties": {
        "generation_mode": {
          "$ref": "#/$defs/GenerationMode"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "prompt_template_id": {
          "title": "Prompt Template Id",
          "type": "string"
        },
        "prompt_template_version": {
          "title": "Prompt Template Version",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        }
      },
      "required": [
        "generation_mode",
        "prompt_template_id",
        "prompt_template_version"
      ],
      "title": "ModelMetadata",
      "type": "object"
    },
    "Role": {
      "enum": [
        "platform_admin",
        "governance_lead",
        "system_owner",
        "control_owner",
        "security_reviewer",
        "privacy_legal_reviewer",
        "internal_audit",
        "executive_approver",
        "read_only_reviewer"
      ],
      "title": "Role",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page or section reference.",
          "title": "Location"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "record_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Version"
        }
      },
      "required": [
        "record_id"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "const": "gap_remediation",
      "title": "Agent Id",
      "type": "string"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "confidence": {
      "description": "Explanatory only; never used as an approval threshold.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "execution_id": {
      "format": "uuid",
      "title": "Execution Id",
      "type": "string"
    },
    "metrics": {
      "$ref": "#/$defs/ExecutionMetrics"
    },
    "missing_information": {
      "items": {
        "type": "string"
      },
      "title": "Missing Information",
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/ModelMetadata"
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/GapRemediationProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Sources",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/AgentStatus"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "execution_id",
    "agent_id",
    "status",
    "sources",
    "assumptions",
    "missing_information",
    "confidence",
    "warnings",
    "model",
    "metrics",
    "content_hash"
  ],
  "title": "GapRemediationOutput",
  "type": "object"
}
