# Names only. Never put credentials or ARNs from a real account in this file.
# Deployed values come from Terraform (Lambda environment) and SSM Parameter Store.

# Backend
APP_ENV=local
DEPLOYMENT_ENVIRONMENT=local
AWS_REGION=eu-west-2
LOG_LEVEL=INFO
DATABASE_CLUSTER_ARN=
DATABASE_SECRET_ARN=
DATABASE_NAME=grail
EVIDENCE_BUCKET=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
ALLOWED_ORIGINS=http://localhost:5173
CLOUDFRONT_ORIGIN_HEADER_PARAMETER=
BEDROCK_ENABLED=false
BEDROCK_MODEL_ALLOWLIST=
AGENT_CATALOG_VERSION=2026-10-17
GOVERNANCE_WORKFLOW_ARN=
AI_DAILY_GLOBAL_LIMIT=0
AI_DAILY_USER_LIMIT=0

# Optional: PostgreSQL URL for online migration checks against a disposable local database
GRAIL_MIGRATION_URL=

# Frontend (Vite). Leave Cognito values empty to use the development persona stub.
VITE_API_BASE_URL=/api
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=

# Local reference to the read-only ATLAS repository (never commit an absolute path)
ATLAS_REFERENCE_PATH=../alex
